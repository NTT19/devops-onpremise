# -*- mode: ruby -*-
# vi: set ft=ruby :

require "yaml"
require "erb"

# ==========================================================
# Paths
# ==========================================================
CONFIG_PATH      = File.expand_path("config/cluster.yml", __dir__)
VALUES_FILE_PATH = File.expand_path("config/values.env", __dir__)

# ==========================================================
# Load .env file
# ==========================================================
def load_env_file(path)
  return unless File.exist?(path)

  File.readlines(path, chomp: true).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, raw_value = line.split("=", 2)
    next if key.nil? || raw_value.nil?

    value = raw_value.strip

    if (value.start_with?('"') && value.end_with?('"')) ||
       (value.start_with?("'") && value.end_with?("'"))
      value = value[1..-2]
    end

    ENV[key.strip] ||= value
  end
end

load_env_file(VALUES_FILE_PATH)

# ==========================================================
# Validate files
# ==========================================================
raise "Missing file: #{CONFIG_PATH}" unless File.exist?(CONFIG_PATH)

unless File.exist?(VALUES_FILE_PATH)
  raise "Missing file: #{VALUES_FILE_PATH}"
end

# ==========================================================
# Load YAML + ERB
# ==========================================================
yaml_content   = ERB.new(File.read(CONFIG_PATH)).result
CLUSTER_CONFIG = YAML.safe_load(yaml_content)

cluster = CLUSTER_CONFIG.fetch("cluster")
nodes   = CLUSTER_CONFIG.fetch("nodes")

# ==========================================================
# Vagrant Configure
# ==========================================================
Vagrant.configure("2") do |config|

  config.vm.box = cluster.fetch("box")

  # Disable synced folder
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # --------------------------------------------------------
  # Common Provision
  # --------------------------------------------------------
  config.vm.provision "shell", inline: <<-SHELL
    set -e

    echo "=== Update system ==="
    apt-get update -y
    apt-get upgrade -y

    echo "=== Disable swap ==="
    swapoff -a || true
    sed -i '/swap/d' /etc/fstab || true

    echo "=== Install common tools ==="
    apt-get install -y curl wget vim net-tools unzip gnupg lsb-release ca-certificates
  SHELL

  # --------------------------------------------------------
  # Nodes Loop
  # --------------------------------------------------------
  nodes.each do |node|

    name          = node.fetch("name")
    ip_last_octet = Integer(node.fetch("ip_last_octet"))
    cpus          = Integer(node.fetch("cpus"))
    memory        = Integer(node.fetch("memory"))

    network_prefix = cluster.fetch("network_prefix")
    private_ip     = "#{network_prefix}.#{ip_last_octet}"

    config.vm.define name do |machine|

      machine.vm.hostname = name

      # Network
      # External LAN Access (Bridge)
      # Change Ethernet -> Wi-Fi if needed
      machine.vm.network "public_network", ip: private_ip, bridge: "Realtek Gaming GbE Family Controller"

      # Extra bootstrap script
      machine.vm.provision "shell", path: "scripts/bootstrap.sh"

      # ==========================================
      # VirtualBox Provider
      # ==========================================
      machine.vm.provider "virtualbox" do |vb|
        vb.name   = name
        vb.cpus   = cpus
        vb.memory = memory

        vb.customize ["modifyvm", :id, "--uart1", "0x3F8", "4"]
        vb.customize ["modifyvm", :id, "--uartmode1", "disconnected"]
      end

      # ==========================================
      # VMware Provider
      # ==========================================
      machine.vm.provider "vmware_desktop" do |vmware|
        vmware.vmx["displayName"] = name
        vmware.vmx["numvcpus"]    = cpus.to_s
        vmware.vmx["memsize"]     = memory.to_s
      end

    end
  end
end